{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.next,.venv,node_modules,tests,docs,screenshot}/**"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
